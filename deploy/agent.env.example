# Flightdeck-CD agent environment.
# Install at /etc/flightdeck/agent.env with mode 0600 (it holds the token).

# Control plane agent endpoint. Use wss:// in production (TLS at the proxy).
FD_CONTROL_PLANE_URL=wss://flightdeck.example.com/agent

# The agent's token, from the control plane's FD_AGENT_TOKENS(_FILE) or
# FD_AGENT_TOKEN. Give each host its own token so one can be revoked.
FD_AGENT_TOKEN=replace-with-this-host-token

# Container socket. A rootless Podman socket the agent user owns is strongly
# preferred over the root Docker socket (which is root-equivalent). Enable it
# for the agent user with:  systemctl --user enable --now podman.socket
# then use that user's runtime dir below (id -u gives the uid).
FD_DOCKER_HOST=unix:///run/user/1001/podman/podman.sock

# This host's name, shown with every service.
HOSTNAME=web-01

# Only containers labelled flightdeck.enable=true are tracked.
FD_LABEL=flightdeck.enable

# Collect each container's env vars and report them (masked in the UI, revealed
# only to an admin role). OFF by default: env values are secrets.
FD_COLLECT_ENV=false
