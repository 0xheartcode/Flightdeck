# Flightdeck-Watcher environment. Copy to .env and adjust.
# cp .env.example .env

# ── Labels (keep low-cardinality) ─────────────────────────────────────────
LOG_ENV=local
LOG_PROJECT=default

# ── Per-project ingest tokens (the gateway's bearer door) ─────────────────
# One per source project so access is revocable per project. Generate with:
#   openssl rand -hex 32
LOKI_TOKEN_PROJECT_A=changeme-project-a
LOKI_TOKEN_PROJECT_B=changeme-project-b

# ── Host ports (left of the colon) ────────────────────────────────────────
FDW_GRAFANA_PORT=3320
FDW_LOKI_PORT=3310
FDW_PROM_PORT=9310
FDW_VECTOR_PORT=9000
FDW_GATEWAY_PORT=8410
FDW_STATUS_PORT=8090

# ── Status page ───────────────────────────────────────────────────────────
FDW_STATUS_INTERVAL_MS=30000
FDW_STATUS_HISTORY=60
