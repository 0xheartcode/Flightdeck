# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# Agent image, multi-arch (linux/amd64 and linux/arm64). The build stage runs
# on the native build platform and cross-compiles to the target architecture
# (ring, the TLS backend, cross-compiles cleanly), which is far faster than
# emulating the target compiler. Runs as a NON-ROOT user by default: in
# production the agent talks to a rootless Podman socket that the same user
# owns. The demo compose mounts the root Docker socket and overrides the user.
# -----------------------------------------------------------------------------

FROM --platform=$BUILDPLATFORM rust:1-bookworm AS build
ARG TARGETARCH
WORKDIR /build
# Resolve the Rust target triple for TARGETARCH, install it, and (for a foreign
# target) the cross linker.
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) target="x86_64-unknown-linux-gnu" ;; \
      arm64) target="aarch64-unknown-linux-gnu"; \
             apt-get update; \
             apt-get install -y --no-install-recommends \
               gcc-aarch64-linux-gnu libc6-dev-arm64-cross; \
             rm -rf /var/lib/apt/lists/* ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    echo "$target" > /tmp/rust-target; \
    rustup target add "$target"
# Linker for the aarch64 cross target (unused when building for amd64).
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
# Cache the dependency compile: build against the manifests and a stub main,
# so changing agent source does not recompile every crate.
COPY Cargo.toml Cargo.lock ./
COPY agent/Cargo.toml ./agent/Cargo.toml
RUN target="$(cat /tmp/rust-target)"; \
    mkdir -p agent/src; \
    echo 'fn main() {}' > agent/src/main.rs; \
    cargo build --release --target "$target" -p flightdeck-agent; \
    rm -rf agent/src
# Now the real source; only the agent crate recompiles. Remove the stub build
# artifacts and touch main.rs so cargo rebuilds the binary (otherwise its
# fingerprint matches the stub and the real code is never compiled).
COPY agent ./agent
RUN target="$(cat /tmp/rust-target)"; \
    rm -f "target/$target/release/flightdeck-agent" "target/$target/release/deps/flightdeck_agent-"*; \
    touch agent/src/main.rs; \
    cargo build --release --target "$target" -p flightdeck-agent; \
    cp "target/$target/release/flightdeck-agent" /flightdeck-agent

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 1001 --user-group flightdeck
COPY --from=build /flightdeck-agent /usr/local/bin/flightdeck-agent
USER 1001
ENTRYPOINT ["/usr/local/bin/flightdeck-agent"]
