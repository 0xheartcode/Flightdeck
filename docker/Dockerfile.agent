# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# Agent image. Runs as a NON-ROOT user by default: in production the agent
# talks to a rootless Podman socket that the same user owns. The demo compose
# mounts the root Docker socket and overrides the user to root to read it.
# -----------------------------------------------------------------------------

FROM rust:1-bookworm AS build
WORKDIR /build
# Cache the dependency compile: build against the manifests and a stub main,
# so changing agent source does not recompile every crate.
COPY Cargo.toml Cargo.lock ./
COPY agent/Cargo.toml ./agent/Cargo.toml
RUN mkdir -p agent/src \
    && echo 'fn main() {}' > agent/src/main.rs \
    && cargo build --release -p flightdeck-agent \
    && rm -rf agent/src
# Now the real source; only the agent crate recompiles. Remove the stub build
# artifacts and touch main.rs so cargo rebuilds the binary (otherwise its
# fingerprint matches the stub and the real code is never compiled).
COPY agent ./agent
RUN rm -f target/release/flightdeck-agent target/release/deps/flightdeck_agent-* \
    && touch agent/src/main.rs \
    && cargo build --release -p flightdeck-agent

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 1001 --user-group flightdeck
COPY --from=build /build/target/release/flightdeck-agent /usr/local/bin/flightdeck-agent
USER 1001
ENTRYPOINT ["/usr/local/bin/flightdeck-agent"]
