# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# Web UI image. Build the static bundle, serve it with nginx (SPA fallback).
# VITE_FD_API_URL is baked at build time; override with a build arg if the
# control plane is not reachable at http://localhost:4000 from the browser.
# -----------------------------------------------------------------------------

FROM node:24-alpine AS build
RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /repo
ARG VITE_FD_API_URL=http://localhost:4000
ENV VITE_FD_API_URL=${VITE_FD_API_URL}
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @flightdeck/web... build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri /index.html; }\n}\n' \
    > /etc/nginx/conf.d/default.conf
EXPOSE 80
