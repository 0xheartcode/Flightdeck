{
  "name": "@flightdeck/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo node_modules"
  },
  "dependencies": {
    "@flightdeck/protocol": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/ws": "8.18.2",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
