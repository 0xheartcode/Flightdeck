# ---------------------------------------------------------------------------
# Flightdeck-CD environment template.
# Copy to .env and fill in. Never commit .env (only this .example file).
# The control plane loads .env automatically; for the agent, see the justfile
# `agent` recipe (it sources .env) or export these before running the binary.
# ---------------------------------------------------------------------------

# Control plane
# ---------------------------------------------------------------------------

# Interface to bind. Must be routable so remote agents can reach it.
FD_CONTROL_PLANE_HOST=0.0.0.0
FD_CONTROL_PLANE_PORT=4000

# Shared bearer token agents must present. REQUIRED: generate a strong value.
#   openssl rand -hex 32
# An empty value rejects all agents.
FD_AGENT_TOKEN=

# Optional token the browser API + log stream require. When set, the web UI
# must send it (see VITE_FD_DASHBOARD_TOKEN). When empty, the browser surface
# is UNAUTHENTICATED: only acceptable on a trusted network. Strongly recommend
# setting it (and running the control plane behind TLS) for anything exposed.
FD_DASHBOARD_TOKEN=

# Allowed browser origin for the REST API and the /stream WebSocket.
# Set to your deployed UI origin. "*" disables the check (not recommended).
FD_CORS_ORIGIN=http://localhost:5173

# How many recent log lines to keep in memory per service.
FD_LOG_BUFFER_SIZE=2000

# ---------------------------------------------------------------------------
# Agent (set on each server running the agent)
# ---------------------------------------------------------------------------

# Control plane agent endpoint. Use wss:// in production (TLS is supported).
FD_CONTROL_PLANE_URL=ws://localhost:4000/agent

# Docker/Podman API socket. Defaults to the local socket when unset.
#   Docker:            unix:///var/run/docker.sock
#   Podman (rootless): unix:///run/user/1000/podman/podman.sock   (recommended)
FD_DOCKER_HOST=unix:///var/run/docker.sock

# Only containers with this label set to "true" are tracked. Label with:
#   --label flightdeck.enable=true  [--label flightdeck.service=my-api]

# ---------------------------------------------------------------------------
# Web UI (build-time, baked into the bundle)
# ---------------------------------------------------------------------------

VITE_FD_API_URL=http://localhost:4000
# Must match FD_DASHBOARD_TOKEN when that is set.
VITE_FD_DASHBOARD_TOKEN=
