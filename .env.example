# ---------------------------------------------------------------------------
# Flightdeck environment template.
# Copy to .env and fill in. Never commit .env (only this .example file).
# The control plane loads .env automatically; for the agent, see the justfile
# `agent` recipe (it sources .env) or export these before running the binary.
# ---------------------------------------------------------------------------

# Control plane
# ---------------------------------------------------------------------------

# Deployment tier: lite | medium | full. Sets feature-flag DEFAULTS (actions,
# Transmitter, managed agent tokens); any explicit FD_* below still overrides.
# Leave unset to keep each flag's own default. See the tier table in README.
# FULL also wants Postgres (FD_DATABASE_URL, `docker compose --profile full`)
# and Loki (FD_LOKI_URL, the flightdeck-watcher stack). Auth is always explicit.
# FD_PROFILE=lite

# Interface to bind. Must be routable so remote agents can reach it.
FD_CONTROL_PLANE_HOST=0.0.0.0
FD_CONTROL_PLANE_PORT=4000

# Agent authentication. Use ONE of the following (checked in this order):
#
#   FD_AGENT_TOKENS_FILE - path to a file of per-agent `name:token` lines. This
#     is the recommended form: each agent gets its own token, and removing a
#     line revokes just that agent (the control plane reloads it live). Example
#     file contents:
#         edge-1:3f9a...   # one per agent, name:token
#         edge-2:7c21...
#   FD_AGENT_TOKENS - the same `name:token` entries inline, comma separated.
#   FD_AGENT_TOKEN  - a single shared token (named "default"); simplest setup.
#
# Generate strong tokens with `openssl rand -hex 32`. With none set, all agents
# are rejected.
FD_AGENT_TOKEN=
# FD_AGENT_TOKENS=edge-1:xxxx,edge-2:yyyy
# FD_AGENT_TOKENS_FILE=/etc/flightdeck/agents

# Optional token the browser API + log stream require. When set, the web UI
# must send it (see VITE_FD_DASHBOARD_TOKEN). When empty, the browser surface
# is UNAUTHENTICATED: only acceptable on a trusted network. Strongly recommend
# setting it (and running the control plane behind TLS) for anything exposed.
# This is the simple single-token mode; for per-user identity, use OIDC below.
FD_DASHBOARD_TOKEN=

# Identity (OIDC/JWT) and role-based access control.
# ---------------------------------------------------------------------------
# Setting a verification key turns identity ON: the browser must present a JWT
# (any OIDC provider that issues JWTs works), the audit log then records the
# user rather than the socket address, and roles gate what each user may do.
# Verification is local (no JWKS fetch): use the HS256 shared secret for a
# symmetric setup, or paste the RS256 public key (PEM) for an asymmetric one.
# When neither is set, the dashboard token above applies and identity is off.
# FD_OIDC_HS256_SECRET=
# FD_OIDC_RS256_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Or point at the provider's JWKS endpoint to track its rotating RS256 keys
# (fetched and refreshed in the background; tokens are matched by their `kid`):
# FD_OIDC_JWKS_URI=https://accounts.example.com/.well-known/jwks.json
# Optional, checked only when set:
# FD_OIDC_ISSUER=https://accounts.example.com
# FD_OIDC_AUDIENCE=flightdeck
# Claim holding the user's roles; a dotted path works (e.g. realm_access.roles).
FD_OIDC_ROLES_CLAIM=roles
# Roles permitted to trigger actions (restart/redeploy), and to reveal env
# values. Comma separated. If both are empty, every authenticated user is a
# trusted operator (single-tenant default).
# FD_OPERATOR_ROLES=operator,admin
# FD_ADMIN_ROLES=admin

# Browser login (OIDC authorization-code + PKCE). When these are set, the UI
# shows a "Sign in" button that redirects to the provider; the control plane
# handles the callback and keeps the session in an HttpOnly cookie, so users do
# not paste a JWT. The id_token is still verified with the keys above (set the
# JWKS URI or a key). Pair with a JWKS URI for a complete setup.
# FD_OIDC_CLIENT_ID=
# FD_OIDC_CLIENT_SECRET=                 # omit for a public client (PKCE only)
# FD_OIDC_AUTH_ENDPOINT=https://accounts.example.com/authorize
# FD_OIDC_TOKEN_ENDPOINT=https://accounts.example.com/oauth/token
# FD_OIDC_REDIRECT_URI=https://flightdeck.example.com/auth/callback
# FD_OIDC_SCOPES=openid profile email
# Secret for signing the login/session cookies (openssl rand -hex 32).
# FD_SESSION_SECRET=
# Where to send the browser after login (defaults to FD_CORS_ORIGIN).
# FD_WEB_APP_URL=https://flightdeck.example.com

# Allowed browser origin for the REST API and the /stream WebSocket.
# Set to your deployed UI origin. "*" disables the check (not recommended).
FD_CORS_ORIGIN=http://localhost:5173

# How many recent log lines to keep in memory per service.
FD_LOG_BUFFER_SIZE=2000

# Rate limits: max concurrent WebSocket connections, and max operator actions
# per browser socket per minute.
FD_MAX_CONNECTIONS=1000
FD_ACTION_RATE_PER_MIN=30

# Control plane logging (pino). Level: trace|debug|info|warn|error|fatal.
# Output is JSON by default, pretty-printed on a TTY; force with FD_LOG_PRETTY.
FD_LOG_LEVEL=info
# FD_LOG_PRETTY=true

# Operator actions (restart/redeploy a container from the UI). Off by default
# because they are disruptive. Enable deliberately, and set FD_DASHBOARD_TOKEN
# so only authenticated browsers can trigger them.
FD_ENABLE_ACTIONS=false

# Audit trail for actions (who/what/when/outcome). Kept in memory and served at
# /api/audit; set a file path to also append it as JSONL so it survives restarts.
FD_AUDIT_MAX=500
# FD_AUDIT_LOG_FILE=/var/lib/flightdeck/audit.jsonl

# Prometheus metrics are served unauthenticated at /metrics (counts only).

# Deploy correlation (GitHub Actions). SQLite stores deploys; ':memory:' is
# ephemeral, set a file path to persist them. Point a GitHub webhook at
# POST /github/webhook with this secret (HMAC); empty disables the endpoint.
# Label a container with flightdeck.repo=owner/name (and optionally
# flightdeck.environment=prod) to correlate its deploys.
FD_DB_FILE=:memory:
FD_GITHUB_WEBHOOK_SECRET=

# High availability: set a Postgres connection string to share deploy state
# across multiple control-plane instances (behind a load balancer). Overrides
# FD_DB_FILE when set. Live log streaming is still per-instance (see docs).
# FD_DATABASE_URL=postgres://user:pass@db:5432/flightdeck

# Durable log search (Loki). When set, every log line is shipped to Loki (on top
# of the in-memory tail) and GET /api/services/:id/logs/search queries it back,
# so history is searchable across time. Empty disables it. FD_LOKI_TENANT sets
# the X-Scope-OrgID header for multi-tenant Loki.
FD_LOKI_URL=
# FD_LOKI_TENANT=

# ---------------------------------------------------------------------------
# Agent (set on each server running the agent)
# ---------------------------------------------------------------------------

# Control plane agent endpoint. Use wss:// in production (TLS is supported).
FD_CONTROL_PLANE_URL=ws://localhost:4000/agent

# Docker/Podman API socket. Defaults to the local socket when unset.
#   Docker:            unix:///var/run/docker.sock
#   Podman (rootless): unix:///run/user/1000/podman/podman.sock   (recommended)
FD_DOCKER_HOST=unix:///var/run/docker.sock

# Only containers with this label set to "true" are tracked. Label with:
#   --label flightdeck.enable=true  [--label flightdeck.service=my-api]

# Collect each container's environment variables and report them to the control
# plane (surfaced read-only in the UI, Railway style). OFF by default: env values
# are secrets. The control plane masks them and only an admin role can reveal
# them. Enable only on trusted deployments.
FD_COLLECT_ENV=false

# Runtime backend: "docker" (Docker/Podman socket, the default) or "systemd".
# The systemd backend tracks the units listed below via systemctl/journalctl
# (state, journal logs, restart). The agent needs permission to manage them.
FD_RUNTIME=docker
# For FD_RUNTIME=systemd: the service units to track, comma separated.
# FD_SYSTEMD_UNITS=nginx.service,myapp.service

# ---------------------------------------------------------------------------
# Web UI (build-time, baked into the bundle)
# ---------------------------------------------------------------------------

VITE_FD_API_URL=http://localhost:4000
# Must match FD_DASHBOARD_TOKEN when that is set.
VITE_FD_DASHBOARD_TOKEN=
