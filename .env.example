# ---------------------------------------------------------------------------
# Flightdeck-CD environment template.
# Copy to .env and fill in. Never commit .env (only this .example file).
# ---------------------------------------------------------------------------

# Shared bearer token the agent uses to authenticate to the control plane.
# Generate a strong value, e.g. `openssl rand -hex 32`.
FD_AGENT_TOKEN=change-me-dev-token

# Control plane HTTP/WS port.
FD_CONTROL_PLANE_PORT=4000

# How many recent log lines the control plane keeps in memory per service.
FD_LOG_BUFFER_SIZE=2000

# ---------------------------------------------------------------------------
# Agent (set on each server running the Rust agent)
# ---------------------------------------------------------------------------

# WebSocket URL of the control plane's agent endpoint.
FD_CONTROL_PLANE_URL=ws://localhost:4000/agent

# Docker/Podman API socket the agent talks to.
#   Docker:           unix:///var/run/docker.sock
#   Podman (rootless) unix:///run/user/1000/podman/podman.sock
FD_DOCKER_HOST=unix:///var/run/docker.sock

# Only containers with this label set to "true" are tracked.
# Label a container with:  --label flightdeck.enable=true
#   (optional)  --label flightdeck.service=my-api   to name the service.

# ---------------------------------------------------------------------------
# Web UI (build-time)
# ---------------------------------------------------------------------------

VITE_FD_API_URL=http://localhost:4000
